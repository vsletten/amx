{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://evtmail.ai/schema/0.1/payment-request.json",
  "title": "AMX payment request",
  "description": "An agent asking a counterparty to pay or approve an amount. Commits money, so the dev gateways hold it for a person (hold rule commits-money).",
  "type": "object",
  "required": ["@context", "@type", "price", "priceCurrency", "amx:payee"],
  "properties": {
    "@context": {"type": ["string", "object", "array"]},
    "@type": {"const": "Invoice"},
    "price": {"type": "string", "pattern": "^[0-9]+(\\.[0-9]{2})?$"},
    "priceCurrency": {"type": "string", "pattern": "^[A-Z]{3}$"},
    "amx:payee": {"type": "string", "minLength": 1},
    "description": {"type": "string"}
  },
  "additionalProperties": true
}
