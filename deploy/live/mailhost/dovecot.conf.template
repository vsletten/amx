# Live Dovecot (docs/selfhost-public.md). envsubst fills ${MAILHOST_IP}, ${GATEWAY_IP}, ${AGENT_DOMAIN}.
listen = *
protocols = imap lmtp
mail_location = maildir:~/Maildir
mail_uid = vmail
mail_gid = vmail
first_valid_uid = 5000
last_valid_uid = 5000

# TLS everywhere a person or a remote runner connects: 993 is implicit TLS, and no password is
# accepted without TLS. The one exception is the gateway on the private network (143, below),
# trusted by address.
ssl = required
ssl_cert = </tls/server.pem
ssl_key = </tls/server-key.pem
ssl_min_protocol = TLSv1.2
ssl_prefer_server_ciphers = yes
disable_plaintext_auth = yes
login_trusted_networks = ${GATEWAY_IP}/32
auth_mechanisms = plain login
auth_master_user_separator = *
mail_plugins = $mail_plugins acl

plugin {
  acl = vfile:/etc/dovecot/dovecot-acl
  acl_globals_only = yes
}

# Master logins are looked up per listening port (real_lport, which a client cannot claim):
#   master-users.143 holds only the gateway, and 143 listens only on the private network;
#   master-users.993 holds only the approver, the one master login the internet can use.
# So the gateway's credential is useless from outside, and a remote runner on 993 has only its
# own login (PLAN §5.9).
passdb {
  driver = passwd-file
  args = /etc/dovecot/master-users.%{real_lport}
  master = yes
  pass = yes
}
passdb {
  driver = passwd-file
  args = /etc/dovecot/users
}
userdb {
  driver = passwd-file
  args = /etc/dovecot/users
}

namespace inbox {
  inbox = yes
  separator = /
  mailbox Drafts {
    auto = subscribe
  }
  mailbox Sent {
    auto = subscribe
  }
  mailbox Trash {
    auto = subscribe
  }
  mailbox Outbox/Held {
    auto = subscribe
  }
  mailbox Outbox/Approved {
    auto = subscribe
  }
  mailbox Outbox/Rejected {
    auto = subscribe
  }
}

service imap-login {
  inet_listener imap {
    address = ${MAILHOST_IP}
    port = 143
  }
  inet_listener imaps {
    port = 993
    ssl = yes
  }
}

service lmtp {
  unix_listener /var/spool/postfix/private/dovecot-lmtp {
    mode = 0600
    user = postfix
    group = postfix
  }
}

protocol imap {
  mail_plugins = $mail_plugins imap_acl
}

protocol lmtp {
  postmaster_address = postmaster@${AGENT_DOMAIN}
}

log_path = /dev/stderr
info_log_path = /dev/stdout
