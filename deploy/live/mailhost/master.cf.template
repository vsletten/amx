# Live Postfix services (docs/selfhost-public.md). envsubst fills ${MAILHOST_IP}, ${GATEWAY_IP}, and
# ${MAX_BYTES}.
smtp      inet  n       -       n       -       -       smtpd
  -o message_size_limit=${MAX_BYTES}
pickup    unix  n       -       n       60      1       pickup
cleanup   unix  n       -       n       -       0       cleanup
qmgr      unix  n       -       n       300     1       qmgr
tlsmgr    unix  -       -       n       1000?   1       tlsmgr
rewrite   unix  -       -       n       -       -       trivial-rewrite
bounce    unix  -       -       n       -       0       bounce
defer     unix  -       -       n       -       0       bounce
trace     unix  -       -       n       -       0       bounce
verify    unix  -       -       n       -       1       verify
flush     unix  n       -       n       1000?   0       flush
proxymap  unix  -       -       n       -       -       proxymap
proxywrite unix -       -       n       -       1       proxymap
smtp      unix  -       -       n       -       -       smtp
relay     unix  -       -       n       -       -       smtp
showq     unix  n       -       n       -       -       showq
error     unix  -       -       n       -       -       error
retry     unix  -       -       n       -       -       error
discard   unix  -       -       n       -       -       discard
local     unix  -       n       n       -       -       local
virtual   unix  -       n       n       -       -       virtual
lmtp      unix  -       -       n       -       -       lmtp
anvil     unix  -       -       n       -       1       anvil
scache    unix  -       -       n       -       1       scache
postlog   unix-dgram n  -       n       -       1       postlogd

# Reinjection from the gateway (PLAN §4.2): no milter, so it trusts exactly one client, the
# gateway's address, and it listens only on this container's address on the bundle's private
# network, which no port publishes. Every other client is refused at connect.
${MAILHOST_IP}:10025 inet n     -       n       -       -       smtpd
  -o syslog_name=postfix/reinject
  -o smtpd_milters=
  -o non_smtpd_milters=
  -o mynetworks=${GATEWAY_IP}/32
  -o smtpd_client_restrictions=permit_mynetworks,reject
  -o smtpd_helo_restrictions=
  -o smtpd_sender_restrictions=
  -o smtpd_relay_restrictions=permit_mynetworks,reject
  -o smtpd_recipient_restrictions=permit_mynetworks,reject
  -o smtpd_tls_security_level=none
  -o smtpd_client_connection_count_limit=0
  -o smtpd_client_connection_rate_limit=0
  -o smtpd_client_message_rate_limit=0
  -o smtpd_recipient_limit=1000
  -o content_filter=

# SH-02 sibling queue admission: gateway only, no milter until the queued copy
# reaches the loopback-only filtered listener. Neither port is published.
${MAILHOST_IP}:10027 inet n     -       n       -       -       smtpd
  -o syslog_name=postfix/sibling-in
  -o smtpd_milters=
  -o non_smtpd_milters=
  -o mynetworks=${GATEWAY_IP}/32
  -o smtpd_client_restrictions=permit_mynetworks,reject
  -o smtpd_helo_restrictions=
  -o smtpd_sender_restrictions=
  -o smtpd_relay_restrictions=permit_mynetworks,reject
  -o smtpd_recipient_restrictions=permit_mynetworks,reject
  -o smtpd_tls_security_level=none
  -o content_filter=sibling-out:[127.0.0.1]:10028

sibling-out unix -      -       n       -       -       smtp
  -o smtp_tls_security_level=none

127.0.0.1:10028 inet n   -       n       -       -       smtpd
  -o syslog_name=postfix/sibling
  -o mynetworks=127.0.0.1/32
  -o smtpd_client_restrictions=permit_mynetworks,reject
  -o smtpd_helo_restrictions=
  -o smtpd_sender_restrictions=
  -o smtpd_relay_restrictions=permit_mynetworks,reject
  -o smtpd_recipient_restrictions=permit_mynetworks,reject
  -o smtpd_tls_security_level=none
  -o milter_macro_daemon_name=amx-sibling
  -o content_filter=
