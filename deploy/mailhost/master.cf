smtp      inet  n       -       n       -       -       smtpd
pickup    unix  n       -       n       60      1       pickup
cleanup   unix  n       -       n       -       0       cleanup
qmgr      unix  n       -       n       300     1       qmgr
tlsmgr    unix  -       -       n       1000?   1       tlsmgr
rewrite   unix  -       -       n       -       -       trivial-rewrite
bounce    unix  -       -       n       -       0       bounce
defer     unix  -       -       n       -       0       bounce
trace     unix  -       -       n       -       0       bounce
verify    unix  -       -       n       -       1       verify
flush     unix  n       -       n       1000?   0       flush
proxymap  unix  -       -       n       -       -       proxymap
proxywrite unix -       -       n       -       1       proxymap
smtp      unix  -       -       n       -       -       smtp
relay     unix  -       -       n       -       -       smtp
showq     unix  n       -       n       -       -       showq
error     unix  -       -       n       -       -       error
retry     unix  -       -       n       -       -       error
discard   unix  -       -       n       -       -       discard
local     unix  -       n       n       -       -       local
virtual   unix  -       n       n       -       -       virtual
lmtp      unix  -       -       n       -       -       lmtp
anvil     unix  -       -       n       -       1       anvil
scache    unix  -       -       n       -       1       scache
postlog   unix-dgram n  -       n       -       1       postlogd

# M2 reinjection listener: trusted Compose subnet, deliberately no milters.
10025     inet  n       -       n       -       -       smtpd
  -o smtpd_milters=
  -o non_smtpd_milters=
  -o mynetworks=172.30.0.0/24
  -o smtpd_relay_restrictions=permit_mynetworks,reject
  -o smtpd_recipient_restrictions=permit_mynetworks,reject
  -o content_filter=

# SH-02: only this mailhost's gateway may queue sibling copies. Filtering happens
# after this transaction commits, so an in-process agent can reply without deadlock.
10027     inet  n       -       n       -       -       smtpd
  -o syslog_name=postfix/sibling-in
  -o smtpd_milters=
  -o non_smtpd_milters=
  -o mynetworks=${GATEWAY_IP}/32
  -o smtpd_client_restrictions=permit_mynetworks,reject
  -o smtpd_relay_restrictions=permit_mynetworks,reject
  -o smtpd_recipient_restrictions=permit_mynetworks,reject
  -o content_filter=sibling-out:[127.0.0.1]:10028

sibling-out unix -      -       n       -       -       smtp
  -o smtp_tls_security_level=none

# Never published or reachable on the container network. The macro is MTA-owned;
# a DKIM signature, header, or connection to port 25 cannot select this grant.
127.0.0.1:10028 inet n   -       n       -       -       smtpd
  -o syslog_name=postfix/sibling
  -o mynetworks=127.0.0.1/32
  -o smtpd_client_restrictions=permit_mynetworks,reject
  -o smtpd_relay_restrictions=permit_mynetworks,reject
  -o smtpd_recipient_restrictions=permit_mynetworks,reject
  -o milter_macro_daemon_name=amx-sibling
  -o content_filter=
